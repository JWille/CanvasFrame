<?xml version="1.0" encoding="utf-8"?>
<!-- Packages for the build (Microsoft.Web.WebView2, the .NET Framework reference assemblies) come from nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
